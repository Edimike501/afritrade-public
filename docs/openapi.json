  "info": {
    "title": "AfriTrade Connect API",
    "description": "Intra-African B2B Trade & Logistics Platform API",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "auth",
      "description": "Authentication and Token Issuance"
    },
    {
      "name": "catalog",
      "description": "Marketplace and Product Catalog"
    },
    {
      "name": "orders",
      "description": "Order Creation and State Lifecycle"
    },
    {
      "name": "payments",
      "description": "Payment Processing & Ledger Inquiries"
    },
    {
      "name": "logistics",
      "description": "Curated Logistics Partners & Shipments"
    },
    {
      "name": "business-profiles",
      "description": "Supplier KYB Verification"
    },
    {
      "name": "dashboard",
      "description": "Role-scoped Platform Metrics"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72
          },
          "fullName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "role": {
            "type": "string",
            "enum": [
              "BUYER",
              "SUPPLIER"
            ]
          },
          "countryCode": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          },
          "preferredCurrency": {
            "type": "string",
            "enum": [
              "NGN",
              "ZAR",
              "GHS",
              "USD"
            ]
          }
        },
        "required": [
          "email",
          "password",
          "fullName",
          "role",
          "countryCode"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UpdateUserPreferencesDto": {
        "type": "object",
        "properties": {
          "preferredCurrency": {
            "type": "string",
            "enum": [
              "NGN",
              "ZAR",
              "GHS",
              "USD"
            ]
          }
        },
        "required": [
          "preferredCurrency"
        ]
      },
      "SubmitKybDto": {
        "type": "object",
        "properties": {
          "businessName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "countryCode": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2
          },
          "contactPhone": {
            "type": "string",
            "maxLength": 32
          }
        },
        "required": [
          "businessName",
          "countryCode"
        ]
      },
      "KybDecisionDto": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "APPROVE",
              "REJECT"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          }
        },
        "required": [
          "decision"
        ]
      },
      "CreateProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "description": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2000
          },
          "category": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "price": {
            "type": "string",
            "pattern": "^\\d{1,12}(\\.\\d{1,2})?$"
          },
          "currencyCode": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "imageUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "name",
          "description",
          "category",
          "price",
          "currencyCode"
        ]
      },
      "UpdateProductDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "description": {
            "type": "string",
            "minLength": 2,
            "maxLength": 2000
          },
          "category": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "price": {
            "type": "string",
            "pattern": "^\\d{1,12}(\\.\\d{1,2})?$"
          },
          "currencyCode": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "imageUrl": {
            "type": "string",
            "format": "uri"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "CreateOrderDto": {
        "type": "object",
        "properties": {
          "items": {
            "minItems": 1,
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "productId": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "quantity": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100000
                }
              },
              "required": [
                "productId",
                "quantity"
              ]
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "UpsertLogisticsPartnerDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "countryCoverage": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2
            }
          },
          "contactEmail": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "contactPhone": {
            "type": "string",
            "maxLength": 32
          },
          "notes": {
            "type": "string",
            "maxLength": 500
          },
          "isActive": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "countryCoverage"
        ]
      },
      "UpdatePartnerDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 160
          },
          "countryCoverage": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2
            }
          },
          "contactEmail": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "contactPhone": {
            "type": "string",
            "maxLength": 32
          },
          "notes": {
            "type": "string",
            "maxLength": 500
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "UpdateShipmentDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ORDER_PLACED",
              "PAYMENT_PENDING",
              "PAYMENT_CONFIRMED",
              "LOGISTICS_ASSIGNED",
              "PICKED_UP",
              "IN_TRANSIT",
              "CUSTOMS",
              "DELIVERED",
              "CANCELLED"
            ]
          },
          "logisticsPartnerId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
