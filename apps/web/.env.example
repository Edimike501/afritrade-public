# ==============================================================================
# AfriTrade Connect Web App (Buyer & Supplier Marketplace) — .env.example
# ==============================================================================

# URL of the NestJS backend API (accessible by the browser)
NEXT_PUBLIC_API_URL=http://localhost:4040

# Base URL of this Next.js web application
NEXT_PUBLIC_APP_URL=http://localhost:3030

# Application environment tag (development | staging | production)
NEXT_PUBLIC_APP_ENV=development
