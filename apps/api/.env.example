# ==============================================================================
# AfriTrade Connect API — Environment Variables (.env.example)
# ==============================================================================

# Server Environment (development | test | staging | production)
NODE_ENV=development
PORT=4040

# ------------------------------------------------------------------------------
# Database & Cache (Zero-Cost Local Dev via Docker Compose)
# ------------------------------------------------------------------------------
# Local postgres running via `pnpm db:up` (port 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/afritrade?schema=public

# Local Redis container running via `pnpm db:up` (port 6379)
# Required for token revocation, session metadata, and RTR reuse detection (RULES.md §18)
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# Authentication & Security Architecture (RULES.md §18)
# ------------------------------------------------------------------------------
# Secret used for signing short-lived (15-minute) in-memory access token JWTs (min 16 chars)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=15m

# Note on Refresh Tokens:
# Refresh tokens in this project are 256-bit cryptographically secure opaque strings
# (generated via crypto.randomBytes) stored as SHA-256 hashes in Redis. They are NOT JWTs.
# A dedicated JWT refresh secret is optional/reserved:
JWT_REFRESH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
REFRESH_TOKEN_EXPIRES_DAYS=7

# ------------------------------------------------------------------------------
# CORS & Web Application URLs
# ------------------------------------------------------------------------------
# Comma-separated origins permitted to send credentialed requests (cookies)
CORS_ORIGINS=http://localhost:3030,http://localhost:3031
WEB_APP_URL=http://localhost:3030

# ------------------------------------------------------------------------------
# Payments (RULES.md §2: simulated mock for MVP, paystack dormant)
# ------------------------------------------------------------------------------
# Options: 'mock' (default, simulated provider) | 'paystack' (dormant in MVP)
PAYMENT_PROVIDER=mock
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:3030/orders

# ------------------------------------------------------------------------------
# Database Seeding Credentials (pnpm seed / prisma db seed)
# ------------------------------------------------------------------------------
# Seed-only: the single admin account (there is no admin self-registration).
SEED_ADMIN_EMAIL=admin@afritrade.test
SEED_ADMIN_PASSWORD=Admin123!@#

# Default password for sample buyer and supplier accounts created during seed
SEED_DEMO_PASSWORD=Password123!

# ------------------------------------------------------------------------------
# Private Document Storage — Cloudflare R2 S3-Compatible (RULES.md §3 & §9)
# ------------------------------------------------------------------------------
# Options: 'simulated' (default for local dev/smoke) | 'r2' (Cloudflare R2 Free Tier)
STORAGE_MODE=simulated|r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=afritrade-kyb-private
R2_SIGNED_URL_EXPIRES_SECONDS=300

